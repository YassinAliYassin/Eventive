# Copy to .env and fill in. Everything here is optional — without it the site
# still runs, and the quote form falls back to opening the visitor's mail app.

PORT=3000

# ── Quote inquiry delivery ───────────────────────────────────────────────────
# Configure ONE of the two options below so POST /api/inquiry can deliver.
# With neither set, the endpoint returns 503 and the browser falls back to
# mailto, so inquiries are never silently dropped.

# Option 1 — email via Resend (https://resend.com). Both values are required.
# INQUIRY_FROM_EMAIL must be an address on a domain you have verified there.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=

# Option 2 — POST the inquiry as JSON to any webhook (Slack, Zapier, Make, n8n).
INQUIRY_WEBHOOK_URL=

# Where inquiries are sent when using Resend. Defaults to events@eventive.co.zw.
INQUIRY_TO_EMAIL=

# ── AI draft planner ─────────────────────────────────────────────────────────
# Powers POST /api/plan, which drafts a run-of-show from a visitor's brief.
# Without a key the endpoint returns 503 and the section presents itself as
# offline, pointing visitors at the quote form instead.
#
# The key is only ever read here, on the server. It must never be exposed to the
# browser — do not move it to a VITE_-prefixed variable, which Vite inlines into
# the client bundle.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=
