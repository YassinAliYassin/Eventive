{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"]
  },
  // server.ts is deliberately not here — it belongs to the main tsconfig so that
  // `tsc --noEmit` type-checks it. Listing it in both makes it a composite output
  // of this project and the main check fails with TS6305.
  "include": ["vite.config.ts"]
}
